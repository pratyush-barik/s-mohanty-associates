// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
// USER ENTITIES (Split Clients & Employees)
// ═══════════════════════════════════════════

model Client {
  id              String               @id @default(cuid())
  email           String               @unique
  password        String
  clientId        String?              @unique // C1000, C1001...
  clientType      ClientType           @default(INDIVIDUAL)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  individual      IndividualProfile?
  organisation    OrganisationProfile?

  // Relations
  serviceRequests ServiceRequest[]
  projectMessages ProjectMessage[]     @relation("ClientMessages")
  documents       Document[]           @relation("ClientDocuments")

  @@map("clients")
}

model IndividualProfile {
  id        String   @id @default(cuid())
  clientId  String   @unique
  name      String
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model OrganisationProfile {
  id               String   @id @default(cuid())
  clientId         String   @unique
  organisationName String
  contactName      String
  mobile           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("organisation_profiles")
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  mobile        String?
  password      String
  role          Role     @default(REPORT_EMPLOYEE)
  isActive      Boolean  @default(true)
  employeeId    String   @unique // e.g. 1000M, 1001R, 1002F
  designation   String?
  profilePhoto  String?  // Supabase Storage URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  managedProjects Project[]        @relation("ProjectManager")
  pendingProjects Project[]        @relation("PendingProjectManager")
  fieldProjects   Project[]        @relation("ProjectFieldEmployees")
  reportProjects  Project[]        @relation("ReportEmployee")
  inspections     Inspection[]
  reports         Report[]
  createdTemplates Template[]
  auditLogs       AuditLog[]
  projectMessages ProjectMessage[] @relation("EmployeeMessages")
  documents       Document[]       @relation("EmployeeDocuments")

  @@map("employees")
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum Role {
  OWNER
  MANAGER
  FIELD_EMPLOYEE
  REPORT_EMPLOYEE
}

enum ClientType {
  INDIVIDUAL
  ORGANISATION
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PENDING_REVIEW
  APPROVED
  ASSIGNED
  INSPECTION_IN_PROGRESS
  INSPECTION_COMPLETED
  REPORT_DRAFTING
  MANAGER_REVIEW
  COMPLETED
  ARCHIVED
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ReportStatus {
  DRAFTING
  SUBMITTED_FOR_REVIEW
  REVISION_REQUESTED
  APPROVED
}

enum TemplateCategory {
  STANDARD_INDIVIDUAL
  STANDARD_RESIDENTIAL
  STANDARD_COMMERCIAL
  ORG_SBI
  ORG_PNB
  ORG_LIC_HOUSING
  ORG_UNION_BANK
  ORG_OTHER
}

enum RetrievalStatus {
  ARCHIVED
  RETRIEVAL_REQUESTED
  RETRIEVED
}

// ═══════════════════════════════════════════
// SERVICE REQUEST & PROJECT
// ═══════════════════════════════════════════

model ServiceRequest {
  id              String        @id @default(cuid())
  clientId        String?
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  propertyDetails String        @db.Text
  propertyType    String
  purpose         String
  propertyAddress String        @db.Text
  contactName     String
  contactPhone    String
  contactEmail    String
  additionalNotes String?       @db.Text
  status          RequestStatus @default(SUBMITTED)
  reviewNotes     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents Document[] @relation("RequestDocuments")
  project   Project?

  @@map("service_requests")
}

model Project {
  id               String        @id @default(cuid())
  projectCode      String        @unique // SMA-YYYY-NNN
  serviceRequestId String        @unique
  status           ProjectStatus @default(PENDING_REVIEW)
  clientReworkRequested Boolean @default(false)
  isEmailOnly      Boolean       @default(false)
  assignedManagerId  String?
  pendingManagerId   String?
  reportEmployeeId   String?
  startDate        DateTime?
  completionDate   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  manager        Employee?       @relation("ProjectManager", fields: [assignedManagerId], references: [id])
  pendingManager Employee?       @relation("PendingProjectManager", fields: [pendingManagerId], references: [id])
  fieldEmployees Employee[]      @relation("ProjectFieldEmployees")
  reportEmployee Employee?       @relation("ReportEmployee", fields: [reportEmployeeId], references: [id])
  messages       ProjectMessage[]
  documents      Document[]      @relation("ProjectDocuments")
  inspection     Inspection?
  report         Report?
  archivedRecord ArchivedRecord?

  @@map("projects")
}

model ProjectMessage {
  id         String   @id @default(cuid())
  projectId  String
  clientId   String?
  employeeId String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client?   @relation("ClientMessages", fields: [clientId], references: [id])
  employee Employee? @relation("EmployeeMessages", fields: [employeeId], references: [id])

  @@map("project_messages")
}

model Document {
  id               String   @id @default(cuid())
  name             String
  url              String
  type             String   // MIME type
  size             Int      // bytes
  clientId         String?
  employeeId       String?
  serviceRequestId String?
  projectId        String?
  inspectionId     String?
  createdAt        DateTime @default(now())

  client         Client?         @relation("ClientDocuments", fields: [clientId], references: [id])
  employee       Employee?       @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  serviceRequest ServiceRequest? @relation("RequestDocuments", fields: [serviceRequestId], references: [id])
  project        Project?        @relation("ProjectDocuments", fields: [projectId], references: [id])
  inspection     Inspection?     @relation(fields: [inspectionId], references: [id])

  @@map("documents")
}

// ═══════════════════════════════════════════
// INSPECTION & REPORT
// ═══════════════════════════════════════════

model Inspection {
  id           String           @id @default(cuid())
  projectId    String           @unique
  employeeId   String
  measurements Json?            // Structured measurement data
  notes        String?          @db.Text
  images       String[]         // Array of R2 URLs
  completedFieldAgents String[] @default([]) // Array of employeeIds who have completed this inspection
  status       InspectionStatus @default(PENDING)
  scheduledDate DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId], references: [id])
  documents Document[]

  @@map("inspections")
}

model Report {
  id          String       @id @default(cuid())
  projectId   String       @unique
  templateId  String?
  employeeId  String
  data        Json?        // Structured report data
  status      ReportStatus @default(DRAFTING)
  fileUrl     String?      // Generated DOCX/PDF URL on R2
  createdAt   DateTime     @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?
  updatedAt   DateTime     @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])

  @@map("reports")
}

model Template {
  id               String           @id @default(cuid())
  name             String
  category         TemplateCategory
  organizationName String?          // For ORG_OTHER
  fields           Json             // Template field definitions
  fileUrl          String?          // DOCX template file on R2
  isActive         Boolean          @default(true)
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy Employee @relation(fields: [createdById], references: [id])
  reports   Report[]

  @@map("templates")
}

// ═══════════════════════════════════════════
// ARCHIVAL & AUDIT
// ═══════════════════════════════════════════

model ArchivedRecord {
  id                     String          @id @default(cuid())
  projectId              String          @unique
  archiveDate            DateTime        @default(now())
  archiveReference       String          @unique // ARC-YYYY-NNN
  retrievalStatus        RetrievalStatus @default(ARCHIVED)
  offlineStorageLocation String?
  notes                  String?         @db.Text

  project Project @relation(fields: [projectId], references: [id])

  @@map("archived_records")
}

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String?
  action     String   // LOGIN, LOGOUT, PROJECT_CREATED, STATUS_CHANGED, etc.
  entityType String?  // User, Project, Report, etc.
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@map("audit_logs")
}

// ═══════════════════════════════════════════
// PUBLIC ENQUIRIES & EMAIL INTEGRATION
// ═══════════════════════════════════════════

model Enquiry {
  id               String        @id @default(cuid())
  ticketNumber     String?       @unique // e.g. SMA-154
  source           EnquirySource @default(WEBSITE)
  name             String
  email            String
  phone            String?
  subject          String
  message          String
  senderType       SenderType    @default(INDIVIDUAL)
  organisationName String?
  status           EnquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())

  messages         EnquiryMessage[]

  @@map("enquiries")
}

model EnquiryMessage {
  id         String     @id @default(cuid())
  enquiryId  String
  sender     SenderRole
  body       String     @db.Text
  createdAt  DateTime   @default(now())

  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@map("enquiry_messages")
}

enum EnquirySource {
  WEBSITE
  EMAIL
}

enum SenderRole {
  CLIENT
  MANAGER
  SYSTEM
}

enum EnquiryStatus {
  NEW
  WAITING_FOR_CLIENT
  IN_PROGRESS
  CLOSED
}

enum SenderType {
  INDIVIDUAL
  ORGANISATION
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otps")
}
